+const _DONUT_SETUP_SCRIPT = String.raw`
+MNT=/mnt/em_sys
+say()  { echo "[*] $*"; }
+warn() { echo "[!] $*"; }
+die()  { echo "[X] $*"; echo _DONUT_FAIL; exit 1; }
