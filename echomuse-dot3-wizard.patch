+    # error, not found, permission denied) is the whole diagnosis.
+    warn "  /tmp/em/busybox true -> $(/tmp/em/busybox true 2>&1; echo "exit $?")"
+    warn "  with FireOS libraries -> $(with_sys /tmp/em/busybox true 2>&1; echo "exit $?")"
+    warn "  /tmp is mounted: $(grep ' /tmp ' /proc/mounts | cut -d' ' -f3,4)"
