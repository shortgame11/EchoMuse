+comment_block() {
+  file="$1"; marker="$2"
+  [ -f "$file" ] || { warn "  $(basename "$file") missing — skipped"; return 0; }
+  if ! grep -q "^on .*$marker" "$file"; then
+    if grep -q "^#on .*$marker" "$file"; then say "  already disabled: $marker"
