+  for n in "system$SLOT" system_a system; do
+    if [ -z "$SYS_DEV" ] && [ -e "$d/$n" ]; then SYS_DEV=$(readlink -f "$d/$n"); fi
+  done
+done
+[ -n "$SYS_DEV" ] || die "no system partition found by name"
+say "system partition: $SYS_DEV"
