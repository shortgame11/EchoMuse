+mkdir -p "$MNT"
+if ! grep -q " $MNT " /proc/mounts; then
+  if ! mount -o rw "$SYS_DEV" "$MNT" 2>/dev/null; then
+    # Mounted read-only elsewhere by TWRP: a second rw mount of the same
+    # superblock is refused, so release it and try again.
