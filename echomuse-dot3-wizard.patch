+say "1/5 Alexa start triggers"
+comment_block "$INIT_DIR/init.smarthomed.rc"  "com.amazon.puffin.PUFFIN_START"
+comment_block "$INIT_DIR/init.commsd.rc"      "audio_mixer.init=true"
