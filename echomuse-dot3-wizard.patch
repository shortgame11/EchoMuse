+service echomuse /system/bin/sh /data/local/bin/start_server.sh
+    class main
+    user root
+    group root system
+    seclabel u:r:su:s0
+    oneshot
+
+on property:sys.boot_completed=1
+    mount tmpfs tmpfs /tmp mode=1777
+    start echomuse
+RC
+chmod 644 "$INIT_DIR/init.echomuse.rc"
+say "  wrote init.echomuse.rc"
+
+say "4/5 busybox"
+if [ -f /tmp/em/busybox ]; then
+  # Stock FireOS 6 on the Dot 3 has no /system/xbin, so create it — with the
+  # same owner, mode and label Android gives it — before copying in.
+  if [ ! -d "$MNT/system/xbin" ]; then
+    mkdir -p "$MNT/system/xbin" || die "could not create /system/xbin"
+    chmod 755 "$MNT/system/xbin"
+    chcon u:object_r:system_file:s0 "$MNT/system/xbin" 2>/dev/null
+    say "  created /system/xbin"
+  fi
+  cp /tmp/em/busybox "$MNT/system/xbin/busybox" && chmod 755 "$MNT/system/xbin/busybox" \
+    || die "could not install busybox"
+  chcon u:object_r:system_file:s0 "$MNT/system/xbin/busybox" 2>/dev/null
+  [ "$(wc -c < /tmp/em/busybox)" = "$(wc -c < "$MNT/system/xbin/busybox")" ] \
+    || die "busybox was not copied to /system/xbin intact"
+  say "  installed /system/xbin/busybox ($(wc -c < "$MNT/system/xbin/busybox") bytes)"
+else
+  say "  /system/xbin/busybox already present"
+fi
+
+say "5/5 SELinux policy"
+if [ -f "$BACKUP_DIR/.sepolicy-patched" ]; then
+  say "  already patched"
+else
+  backup "$SEPOL"
+  chmod 755 /tmp/em-magiskpolicy
+  rm -f /tmp/sepolicy.new
+  with_sys /tmp/em-magiskpolicy --load "$SEPOL" --save /tmp/sepolicy.new \
+    'allow init su process { transition rlimitinh siginh noatsecure }' 'permissive su' 2>&1
